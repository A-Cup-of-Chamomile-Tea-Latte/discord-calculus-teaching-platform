# Never paste either token into chat or commit this file.
COURSE_ASSISTANT_TOKEN=
COURSE_ASSISTANT_CLIENT_ID=
DUMP_BOT_TOKEN=
DUMP_BOT_CLIENT_ID=

# Discord server ID for the empty test server.
TEST_GUILD_ID=

# Discord user IDs allowed to run destructive lab commands.
# Comma-separated. If empty, only the Discord server owner is accepted.
BOT_OWNER_IDS=

# Local-only test defaults.
TEST_MODULE_CODE=M1
DATABASE_PATH=./data/course_bots.sqlite3
LOG_LEVEL=INFO

# Draft timing can be shortened in the empty test server.
# Suggested first test: 300 and 600 seconds.
DRAFT_REMINDER_SECONDS=86400
DRAFT_DELETE_SECONDS=172800

# 案件：教學團隊回覆後 48 小時提醒，再 48 小時自動結案。
CASE_IDLE_SECONDS=172800
CASE_AUTO_CLOSE_SECONDS=172800

# 已受理但尚未完成建立的隱密支援容量；超過時仍保留在 durable queue。
PRIVATE_OPEN_CAPACITY=50
