---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = "" } = Astro.props;
const pageTitle = `${title}｜微積分教學支援`;
const navItems = [
  {
    href: withBase("join/"),
    label: "加入與設定",
    current: currentPath === "join",
  },
  { href: withBase("ask/"), label: "提問", current: currentPath === "ask" },
  {
    href: withBase("discord-guide/"),
    label: "Discord 指南",
    current: currentPath === "discord-guide",
  },
  {
    href: withBase("cases/"),
    label: "查案件",
    current: currentPath === "cases",
  },
  {
    href: withBase("guide/"),
    label: "使用指南",
    current: currentPath === "guide",
  },
  {
    href: withBase("settings/"),
    label: "我的設定",
    current: currentPath === "settings",
  },
  {
    href: withBase("status/"),
    label: "系統狀態",
    current: currentPath === "status",
  },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("calculus-portal-theme");
          document.documentElement.dataset.theme =
            saved === "student" ? "student" : "formal";
        } catch {
          document.documentElement.dataset.theme = "formal";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <SiteHeader homeHref={withBase("")} navItems={navItems} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter
      guideHref={withBase("guide/")}
      statusHref={withBase("status/")}
    />
  </body>
</html>
