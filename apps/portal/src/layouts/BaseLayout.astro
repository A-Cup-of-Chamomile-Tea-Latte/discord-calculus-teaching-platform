---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  requiredRole?: "staff" | "admin";
}

const { title, description, currentPath = "", requiredRole } = Astro.props;
const isPublicBuild = import.meta.env.PUBLIC_PORTAL_BUILD === "true";
const pageTitle = `${title}｜微積分教學支援`;
const accessSessionScript = `
  (() => {
    try {
      const raw = sessionStorage.getItem("calculus-local-session-v1");
      const session = raw ? JSON.parse(raw) : null;
      const role = session?.role;
      document.documentElement.dataset.accessRole =
        (role === "staff" || role === "admin") &&
        typeof session?.expiresAt === "number" &&
        session.expiresAt > Date.now()
          ? role
          : "guest";
    } catch {
      document.documentElement.dataset.accessRole = "guest";
    }
  })();
`;
const navItems = [
  {
    href: withBase("join/"),
    label: "加入與設定",
    current: currentPath === "join",
  },
  {
    href: withBase("cases/"),
    label: "查案件",
    current: currentPath === "cases",
  },
  {
    href: withBase("guide/"),
    label: "使用指南",
    current: currentPath === "guide",
  },
];
---

<!doctype html>
<html lang="zh-Hant" data-access-role="guest">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {requiredRole && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {!isPublicBuild && <script is:inline set:html={accessSessionScript} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <SiteHeader
      homeHref={withBase("")}
      accessHref={withBase("access/")}
      navItems={navItems}
      showInternalAccess={!isPublicBuild}
    />
    <main id="main-content" tabindex="-1" data-required-role={requiredRole}>
      {
        requiredRole && (
          <section
            class="access-required shell section"
            aria-labelledby="access-required-title"
          >
            <p class="eyebrow">內部工作區</p>
            <h1 id="access-required-title">這一頁需要內部身份</h1>
            <p>
              {requiredRole === "admin"
                ? "請以系統管理員身份登入後開啟。"
                : "請以助教、教師或系統管理員身份登入後開啟。"}
            </p>
            <a
              class="button"
              href={`${withBase("access/")}?role=${requiredRole}`}
            >
              {requiredRole === "admin" ? "系統管理員登入" : "助教／教師登入"}
            </a>
          </section>
        )
      }
      <div class="protected-content"><slot /></div>
    </main>
    <SiteFooter
      guideHref={withBase("guide/")}
      statusHref={withBase("status/")}
      showInternalLinks={!isPublicBuild}
    />
  </body>
</html>

<style>
  .access-required {
    display: none;
    max-width: 38rem;
    text-align: center;
  }

  html[data-access-role="guest"] main[data-required-role] .access-required,
  html[data-access-role="staff"]
    main[data-required-role="admin"]
    .access-required {
    display: block;
  }

  html[data-access-role="guest"] main[data-required-role] .protected-content,
  html[data-access-role="staff"]
    main[data-required-role="admin"]
    .protected-content {
    display: none;
  }
</style>
