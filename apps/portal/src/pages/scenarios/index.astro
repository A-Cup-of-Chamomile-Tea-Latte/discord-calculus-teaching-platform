---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

type ScenarioTone = "info" | "success" | "warning" | "danger" | "neutral";
type ScenarioItem = readonly [string, string, ScenarioTone];
interface ScenarioGroup {
  title: string;
  description: string;
  items: readonly ScenarioItem[];
}

const scenarioGroups: readonly ScenarioGroup[] = [
  {
    title: "案件流程",
    description: "從建立、接手到結案的主要狀態。",
    items: [
      ["新案件", "Open；尚未由教學團隊接手。", "info"],
      ["尚未回覆", "已建立案號，但教學團隊尚未回覆。", "info"],
      ["TA 已接手", "Tracked；對學生顯示為「進行中」。", "success"],
      ["Idle", "TA 最後留言後 48 小時無學生回覆。", "warning"],
      ["手動結案", "由 Staff 操作；標題前綴 ✅。", "neutral"],
      ["自動結案", "Idle 後再 48 小時；前綴 („• ֊ •„)。", "neutral"],
    ],
  },
  {
    title: "內容與隱私",
    description: "附件、AI 同意與受保護內容的顯示規則。",
    items: [
      ["含附件", "只顯示 metadata marker 與 Discord 連結。", "info"],
      ["AI 允許", "OP 明確選 Yes；仍需逐作者過濾。", "success"],
      ["AI 不允許", "保存服務紀錄，但排除分析。", "neutral"],
      ["Private Support", "不進公開查詢，只顯示受保護流程。", "danger"],
      [
        "未完成文章屬性",
        "Bot 提示補齊 main tag、Module 與 AI 選擇。",
        "warning",
      ],
    ],
  },
  {
    title: "重新開啟與同步",
    description: "短暫操作狀態與資料更新狀況。",
    items: [
      ["重新開啟中", "操作處理中；不是長期案件狀態。", "warning"],
      ["已重新開啟", "沿用原案號與討論串，回到 Tracked。", "success"],
      ["同步落後", "最近同步時間超過展示門檻。", "warning"],
    ],
  },
  {
    title: "系統例外",
    description: "查詢無法正常完成時的安全回應。",
    items: [
      ["系統離線", "查詢保留輸入並顯示備援管道。", "danger"],
      ["不存在案號", "不揭露相似案件或 Private Support。", "neutral"],
    ],
  },
] as const;

const toneLabels: Record<ScenarioTone, string> = {
  info: "資訊",
  success: "正常",
  warning: "需留意",
  danger: "受保護",
  neutral: "一般",
} as const;
const scenarios = scenarioGroups.flatMap((group) => group.items);
const attentionCount = scenarios.filter(
  ([, , tone]) => tone === "warning" || tone === "danger",
).length;
const successCount = scenarios.filter(
  ([, , tone]) => tone === "success",
).length;
---

<BaseLayout
  title="情境庫"
  description="用虛構資料比較案件、附件、AI、結案、離線與同步狀態。"
  requiredRole="admin"
>
  <div class="shell stack section" style="--stack-gap: var(--space-6)">
    <header class="reading-width">
      <p><a href={withBase("")}>首頁</a> / 情境庫</p>
      <h1>案件情境總覽</h1>
      <p>
        這是設計與操作測試用的完整狀態表；所有文字、案號與人物都是虛構資料。
      </p>
    </header>

    <dl class="scenario-summary" aria-label="情境庫摘要">
      <div><dt>全部情境</dt><dd>{scenarios.length}</dd></div>
      <div><dt>狀態分組</dt><dd>{scenarioGroups.length}</dd></div>
      <div><dt>需留意／受保護</dt><dd>{attentionCount}</dd></div>
      <div><dt>正常狀態</dt><dd>{successCount}</dd></div>
    </dl>

    <div class="scenario-board">
      {
        scenarioGroups.map((group) => (
          <section
            class="scenario-group"
            aria-labelledby={`group-${group.title}`}
          >
            <header>
              <div>
                <h2 id={`group-${group.title}`}>{group.title}</h2>
                <p>{group.description}</p>
              </div>
              <span>{group.items.length} 項</span>
            </header>
            <ul>
              {group.items.map(([title, description, tone]) => (
                <li data-tone={tone}>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <span class="scenario-tone">{toneLabels[tone]}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .scenario-summary {
    display: grid;
    margin: 0;
    border-block: var(--border-thin) solid var(--color-border);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .scenario-summary div {
    padding: var(--space-4);
  }

  .scenario-summary div + div {
    border-inline-start: var(--border-thin) solid var(--color-border);
  }

  .scenario-summary dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .scenario-summary dd {
    margin: var(--space-1) 0 0;
    color: var(--color-action);
    font-size: var(--font-size-xl);
    font-weight: 800;
    line-height: 1;
  }

  .scenario-board {
    display: grid;
    border-top: var(--border-strong) solid var(--color-text);
  }

  .scenario-group {
    display: grid;
    padding-block: var(--space-5);
    border-bottom: var(--border-thin) solid var(--color-border);
    gap: var(--space-4);
  }

  .scenario-group > header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: start;
  }

  .scenario-group > header h2,
  .scenario-group > header p {
    margin-bottom: 0;
  }

  .scenario-group > header p {
    color: var(--color-text-muted);
  }

  .scenario-group > header > span {
    flex: 0 0 auto;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .scenario-group ul {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: var(--border-thin) solid var(--color-border);
    list-style: none;
  }

  .scenario-group li {
    display: grid;
    min-width: 0;
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    border-bottom: var(--border-thin) solid var(--color-border);
    border-inline-start: 0.25rem solid var(--tone-color);
    gap: var(--space-2) var(--space-4);
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr) auto;
    align-items: center;
  }

  .scenario-group li[data-tone="info"] {
    --tone-color: var(--color-info-border);
  }

  .scenario-group li[data-tone="success"] {
    --tone-color: var(--color-success-border);
  }

  .scenario-group li[data-tone="warning"] {
    --tone-color: var(--color-warning-border);
  }

  .scenario-group li[data-tone="danger"] {
    --tone-color: var(--color-danger-border);
  }

  .scenario-group li[data-tone="neutral"] {
    --tone-color: var(--color-neutral-border);
  }

  .scenario-group h3,
  .scenario-group li p {
    margin: 0;
  }

  .scenario-group li p {
    color: var(--color-text-muted);
  }

  .scenario-tone {
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin) solid var(--tone-color);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 750;
    white-space: nowrap;
  }

  @media (max-width: 42rem) {
    .scenario-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .scenario-summary div:nth-child(odd) {
      border-inline-start: 0;
    }

    .scenario-summary div:nth-child(n + 3) {
      border-top: var(--border-thin) solid var(--color-border);
    }

    .scenario-group li {
      grid-template-columns: 1fr auto;
    }

    .scenario-group li p {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
