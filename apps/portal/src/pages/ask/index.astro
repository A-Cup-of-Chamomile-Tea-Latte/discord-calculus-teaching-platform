---
import Alert from "../../components/Alert.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import FormField from "../../components/FormField.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
---

<BaseLayout
  title="透過網站代送（替代方案）"
  description="一般問題的不送出 fixture form 與 confirmation。"
  currentPath="ask"
>
  <div class="shell stack section">
    <header class="reading-width">
      <p><a href={withBase("")}>首頁</a> / 提問</p>
      <h1>透過網站代送（替代方案）</h1>
      <p>
        你仍可直接在 Discord 發問；此頁用完整欄位整理 Forum、Module 與 main
        tag，只在本機建立 confirmation。
      </p>
    </header>

    <Alert title="正式課務請以 NTU COOL 為準" tone="warning">
      <p>此表單不能修改作業、期限、成績或課程政策，也不取代正式公告。</p>
    </Alert>

    <div class="route-choice" role="note">
      <div>
        <h2>這是一般問題</h2>
        <p>公開 Forum 對課程社群可見；Module 只做分類，不限制可見性。</p>
      </div>
      <div>
        <h2>需要 Private Support？</h2>
        <p>
          私密支援走獨立路徑、不進公開查詢，也會要求明確選擇 AI 分析 Yes／No。
        </p>
        <ButtonLink href={withBase("private-support/")} variant="secondary"
          >改用 Private Support</ButtonLink
        >
      </div>
    </div>

    <section
      class="prototype-panel"
      data-fixture-form
      data-form-kind="question"
      aria-labelledby="question-form-title"
    >
      <div class="reading-width">
        <p class="fixture-marker">Fixture mode · 不會送出</p>
        <h2 id="question-form-title">建立一般問題預覽</h2>
        <p>
          所有內容只留在目前頁面 DOM；沒有 file upload、network request 或
          browser storage。
        </p>
      </div>

      <form class="prototype-form" novalidate>
        <div
          class="form-error-summary"
          data-form-errors
          role="alert"
          tabindex="-1"
          hidden
        >
          <h3>還有幾個地方可以補充</h3>
          <p>不會清除已輸入內容：</p>
          <ul></ul>
        </div>

        <div class="grid grid--auto">
          <FormField
            forId="question-forum"
            label="Forum"
            hint="選擇問題的公開討論區。"
            required
          >
            <select
              id="question-forum"
              name="forum"
              aria-describedby="question-forum-hint question-forum-error"
            >
              <option value="">請選擇</option>
              <option value="MATH">Math Questions</option>
              <option value="COURSEWORK">Coursework / Systems</option>
              <option value="OTHER">Other Problem / Free Talk</option>
            </select>
            <p
              id="question-forum-error"
              class="field-error"
              data-field-error="forum"
              hidden
            >
            </p>
          </FormField>

          <FormField
            forId="question-problem-type"
            label="問題類型"
            hint="例如：微積分觀念、WeBWorK、教材勘誤。"
            required
          >
            <input
              id="question-problem-type"
              name="problemType"
              maxlength="40"
              value="微積分觀念"
              aria-describedby="question-problem-type-hint question-problem-type-error"
            />
            <p
              id="question-problem-type-error"
              class="field-error"
              data-field-error="problemType"
              hidden
            >
            </p>
          </FormField>

          <FormField
            forId="question-module"
            label="Module"
            hint="本機展示由 fixture Class 對照；正式表單不讓學生任意指定。"
            required
          >
            <select
              id="question-module"
              name="module"
              aria-describedby="question-module-hint question-module-error"
            >
              <option value="M1">M1（fixture Class 12）</option>
              <option value="M2">M2（fixture）</option>
              <option value="M3">M3（fixture）</option>
              <option value="M4">M4（fixture）</option>
            </select>
            <p
              id="question-module-error"
              class="field-error"
              data-field-error="module"
              hidden
            >
            </p>
          </FormField>

          <FormField
            forId="question-main-tag"
            label="Main tag"
            hint="只會有一個 main tag 進入標題。"
            required
          >
            <input
              id="question-main-tag"
              name="mainTag"
              maxlength="20"
              value="觀念"
              aria-describedby="question-main-tag-hint question-main-tag-error"
            />
            <p
              id="question-main-tag-error"
              class="field-error"
              data-field-error="mainTag"
              hidden
            >
            </p>
          </FormField>
        </div>

        <FormField
          forId="question-title"
          label="問題標題"
          hint="5–160 個字元。"
          required
        >
          <input
            id="question-title"
            name="title"
            maxlength="160"
            autocomplete="off"
            aria-describedby="question-title-hint question-title-error"
          />
          <p
            id="question-title-error"
            class="field-error"
            data-field-error="title"
            hidden
          >
          </p>
        </FormField>

        <FormField
          forId="question-content"
          label="問題內容"
          hint="至少 20 個字元；請勿貼真實敏感資料到 fixture。"
          required
        >
          <textarea
            id="question-content"
            name="content"
            maxlength="5000"
            aria-describedby="question-content-hint question-content-error"
          ></textarea>
          <p
            id="question-content-error"
            class="field-error"
            data-field-error="content"
            hidden
          >
          </p>
        </FormField>

        <fieldset class="choice-group">
          <legend>可見範圍 *</legend>
          <label
            ><input type="radio" name="visibility" value="COURSE" checked /> 公開課程社群可見</label
          >
          <p>Module 只做分類，不限制公開 Forum 的可見性。</p>
          <p class="field-error" data-field-error="visibility" hidden></p>
        </fieldset>

        <fieldset class="choice-group">
          <legend>作者顯示 *</legend>
          <label
            ><input type="radio" name="authorDisplayMode" value="REAL_NAME" />
            目前 Discord 身份</label
          >
          <label
            ><input
              type="radio"
              name="authorDisplayMode"
              value="COURSE_ALIAS"
              checked
            /> course alias</label
          >
          <label
            ><input type="radio" name="authorDisplayMode" value="ANONYMOUS" /> 對一般成員匿名</label
          >
          <p>
            完全匿名 follow-up 必須由網站或 Discord modal 轉交 bot
            代貼，不能以本人帳號回覆後再刪除。
          </p>
          <p class="field-error" data-field-error="authorDisplayMode" hidden>
          </p>
        </fieldset>

        <fieldset class="choice-group">
          <legend>是否允許 AI 輔助教學分析？*</legend>
          <p>
            允許系統在去識別化與人工複核後，使用 AI
            分析本案件內容，以改善教學與整理常見問題。選擇 No
            不影響提問與回覆；教學團隊仍可基於課程運作需要閱讀及保存案件紀錄。
          </p>
          <label
            ><input
              type="radio"
              name="analysisPermission"
              value="INCLUDED"
              required
            /> Yes</label
          >
          <label
            ><input type="radio" name="analysisPermission" value="EXCLUDED" /> No</label
          >
          <p>
            Original poster 的選擇決定案件層級資格；database fixture
            是唯一依據，Discord 標題或 tag 只會反映結果。OP 選 Yes
            時，其他作者仍保留逐訊息過濾介面。
          </p>
          <p class="field-error" data-field-error="analysisPermission" hidden>
          </p>
        </fieldset>

        <FormField
          forId="question-attachment"
          label="附件 metadata"
          hint="只填檔名與大小描述；不會讀取或上傳檔案。"
        >
          <input
            id="question-attachment"
            name="attachmentName"
            maxlength="160"
            placeholder="diagram-fixture.png (120 KB)"
            autocomplete="off"
            aria-describedby="question-attachment-hint question-attachment-error"
          />
          <p
            id="question-attachment-error"
            class="field-error"
            data-field-error="attachmentName"
            hidden
          >
          </p>
        </FormField>

        <fieldset class="choice-group">
          <legend>正式課務確認</legend>
          <label>
            <input type="checkbox" name="coolAcknowledgement" value="yes" />
            我了解教材、作業、成績、期限、公告與課程政策仍以 NTU COOL 為準。*
          </label>
          <p class="field-error" data-field-error="coolAcknowledgement" hidden>
          </p>
        </fieldset>

        <div class="form-actions">
          <button type="submit">建立一般問題 fixture</button>
          <ButtonLink href={withBase("private-support/")} variant="quiet"
            >需要私密支援</ButtonLink
          >
        </div>
      </form>

      <section
        class="fixture-confirmation"
        data-fixture-confirmation
        tabindex="-1"
        hidden
      >
        <p class="fixture-marker">Fixture confirmation · 未送出</p>
        <h2 data-confirmation-title>一般問題 fixture 已建立</h2>
        <p>本機參考編號：<strong data-confirmation-reference></strong></p>
        <dl data-confirmation-summary></dl>
        <Alert title="沒有案件被建立">
          <p>
            此參考編號不能用於 public case lookup；沒有內容送往
            Discord、GAS、email 或 file storage。
          </p>
        </Alert>
        <button
          type="button"
          class="button button--secondary"
          data-fixture-reset>返回並清除表單</button
        >
      </section>
    </section>
  </div>
</BaseLayout>

<script>
  import "../../scripts/fixture-forms";
</script>
