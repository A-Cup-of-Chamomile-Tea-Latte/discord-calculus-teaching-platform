---
import ButtonLink from "../components/ButtonLink.astro";
import StatePanel from "../components/StatePanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="找不到頁面" description="找不到此 Portal 頁面。">
  <div class="shell section">
    <h1 class="visually-hidden">找不到頁面</h1>
    <StatePanel kind="error" title="找不到這個頁面">
      <p>這不代表某個案件存在或不存在；請由首頁或案件查詢重新開始。</p>
      <div slot="action" class="cluster">
        <ButtonLink href={withBase("")}>回首頁</ButtonLink>
        <ButtonLink href={withBase("cases/")} variant="secondary"
          >查案件</ButtonLink
        >
        <ButtonLink href={withBase("guide/")} variant="quiet"
          >使用指南</ButtonLink
        >
      </div>
    </StatePanel>
  </div>
</BaseLayout>
