---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

const buildGates = [
  {
    label: "公開／內部路由分離",
    status: "DONE",
    note: "公開發布檔移除內部工具、舊路由與管理狀態頁。",
  },
  {
    label: "學生資訊架構與文案",
    status: "IN_PROGRESS",
    note: "首頁、加入、案件查詢與合併指南正在逐頁驗收。",
  },
  {
    label: "Course Manager 加入審核",
    status: "PENDING",
    note: "v13 已有資料模型與 API；Portal service、正式 session issuer、Email 寄送與白帳號 E2E 仍待驗收。",
  },
  {
    label: "隱密支援正式化",
    status: "PENDING",
    note: "現有 /private open 尚未完成；仍需驗收權限、關閉與匯出流程。",
  },
  {
    label: "案件狀態查詢後端",
    status: "PENDING",
    note: "v13 已完成最小欄位與 same-origin API；尚未以獨立服務接到 production SQLite，也沒有正式 session issuer。",
  },
  {
    label: "網站公開發布",
    status: "PENDING",
    note: "Beta 網址已定為數學系 /~calc/DC-platform-beta/；首次上傳、API 轉送與外部驗收尚未執行。",
  },
];

const monitorCards = [
  {
    label: "Production core",
    value: "v13／schema 13",
    note: "依 2026-08-27 遠端交接：active release feab01757897，三服務 active／enabled，critical queues 為 0。",
  },
  {
    label: "Discord ops smoke",
    value: "已通過",
    note: "/ops status 與 /ops attention-list 已通過；這不代表 Email 或白帳號 E2E 已通過。",
  },
  {
    label: "公開網站",
    value: "Beta 準備中",
    note: "公開路徑已確定；交付前仍要完成正式建置、敏感資訊檢查與數學系端部署。",
  },
  {
    label: "API／寄信服務",
    value: "尚未正式部署",
    note: "Portal backend service、session issuer、API 轉送與 GAS 實寄仍待完成；瀏覽器目前維持 fail closed。",
  },
];
---

<BaseLayout
  title="建造與系統狀態"
  description="系統管理員使用的建置清單與監控入口。"
  requiredRole="admin"
>
  <div class="shell stack section" style="--stack-gap: var(--space-7)">
    <header class="status-intro">
      <div>
        <p><a href={withBase("access/")}>內部工作區</a> / 建造與系統狀態</p>
        <h1>建造與系統狀態</h1>
        <p>
          v13 核心已上線；Portal 與 Email 仍在發布前驗收。全部通過後，這一頁只保留長期監控資訊。
        </p>
      </div>
      <span class="mode-badge">Portal 驗收中</span>
    </header>

    <section aria-labelledby="snapshot-title">
      <div class="section-heading">
        <div>
          <h2 id="snapshot-title">目前系統狀態</h2>
          <p>
            頁面核對：2026-08-27。Production core 已是 v13；證據來自遠端交接與 Discord
            ops smoke，本機沒有直接連線朋友主機。Portal 網址與 API 目前尚未部署。
          </p>
        </div>
      </div>
      <dl class="monitor-grid">
        {
          monitorCards.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
              <p>{item.note}</p>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="gates-title">
      <div class="section-heading">
        <div>
          <h2 id="gates-title">Portal 發布檢查</h2>
          <p>v13 core 上線不等於 Portal 已接線；每一項仍要通過測試或人工驗收。</p>
        </div>
      </div>
      <ol class="gate-list">
        {
          buildGates.map((gate) => (
            <li data-status={gate.status}>
              <span class="gate-symbol" aria-hidden="true">
                {gate.status === "DONE"
                  ? "✓"
                  : gate.status === "IN_PROGRESS"
                    ? "◐"
                    : "○"}
              </span>
              <div>
                <h3>{gate.label}</h3>
                <p>{gate.note}</p>
              </div>
              <strong>
                {gate.status === "DONE"
                  ? "完成"
                  : gate.status === "IN_PROGRESS"
                    ? "進行中"
                    : "待處理"}
              </strong>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="transition-note" aria-labelledby="monitor-title">
      <div>
        <h2 id="monitor-title">完成建置後的監控內容</h2>
        <p>
          屆時只顯示服務健康狀態、資料更新時間、待處理工作量、最近發布、備份與還原驗證，以及需要人工注意的事項。不顯示學生內容、ID、檔案路徑、完整錯誤訊息或機密資料。
        </p>
      </div>
      <span aria-label="尚未切換">尚未啟用</span>
    </section>

    <details class="source-note">
      <summary>事實來源與更新規則</summary>
      <p>
        系統現況以程式碼儲存庫、最新交接與僅限管理員使用的
        <code>/ops status</code> 安全摘要交叉核對。更新本頁後，舊快照移入封存區，不與現況並列。
      </p>
    </details>
  </div>
</BaseLayout>

<style>
  .status-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .status-intro > div {
    max-width: var(--reading-width);
  }

  .mode-badge {
    padding: var(--space-2) var(--space-4);
    border: var(--border-thin) solid var(--color-warning-border);
    border-radius: 999px;
    background: var(--color-warning-bg);
    font-weight: 800;
  }

  .monitor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    margin: 0;
    gap: var(--space-3);
  }

  .monitor-grid > div {
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-low);
  }

  .monitor-grid dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .monitor-grid dd {
    margin: var(--space-2) 0;
    color: var(--color-action);
    font-size: var(--font-size-lg);
    font-weight: 800;
  }

  .monitor-grid p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gate-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .gate-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .gate-list h3,
  .gate-list p {
    margin-bottom: var(--space-1);
  }

  .gate-list li > strong {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gate-symbol {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: var(--border-thin) solid currentColor;
    border-radius: 50%;
    color: var(--color-neutral-border);
    font-weight: 850;
  }

  .gate-list li[data-status="DONE"] .gate-symbol {
    background: var(--color-success-bg);
    color: var(--color-success-border);
  }

  .gate-list li[data-status="IN_PROGRESS"] .gate-symbol {
    background: var(--color-warning-bg);
    color: var(--color-warning-border);
  }

  .transition-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-action);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .transition-note > div {
    max-width: var(--reading-width);
  }

  .transition-note > span {
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--color-neutral-bg);
    color: var(--color-text-muted);
    font-weight: 750;
  }

  .source-note {
    max-width: var(--reading-width);
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .source-note summary {
    cursor: pointer;
    font-weight: 750;
  }

  .source-note p {
    padding-top: var(--space-3);
  }

  @media (max-width: 34rem) {
    .gate-list li {
      grid-template-columns: auto 1fr;
    }

    .gate-list li > strong {
      grid-column: 2;
    }
  }
</style>
