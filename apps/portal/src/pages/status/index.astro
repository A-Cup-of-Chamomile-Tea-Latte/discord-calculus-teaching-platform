---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

const buildGates = [
  {
    label: "公開／內部路由分離",
    status: "DONE",
    note: "公開發布檔移除內部工具、舊路由與管理狀態頁。",
  },
  {
    label: "學生資訊架構與文案",
    status: "IN_PROGRESS",
    note: "首頁、加入、案件查詢與合併指南正在逐頁驗收。",
  },
  {
    label: "Course Manager 加入審核",
    status: "IN_PROGRESS",
    note: "v13 Bot 已上線；Portal 加入流程與分 scope session 已通過本機驗證，GAS provider smoke 也已通過。完整流程仍待 external staging 與白帳號 E2E。",
  },
  {
    label: "隱密支援正式化",
    status: "IN_PROGRESS",
    note: "production 已提供 /private open 與案件生命週期；仍需以白帳號驗收實際 ACL、關閉、private dump 與自動刪除流程。",
  },
  {
    label: "案件狀態查詢後端",
    status: "IN_PROGRESS",
    note: "Case ID 最小狀態查詢、same-origin API 與分 scope session 已可用 synthetic SQLite 測試；尚未接 production SQLite，也沒有 production hosting。",
  },
  {
    label: "網站公開發布",
    status: "PENDING",
    note: "規劃路徑為數學系 /~calc/DC-platform-beta/；系網掛載尚未授權，未上傳網站、未設定 API 轉送，也未進行外部驗收。",
  },
];

const monitorCards = [
  {
    label: "Production Bot",
    value: "v13／schema 13",
    note: "依 2026-08-27 遠端交接：active release feab01757897，三服務 active／enabled，critical queues 為 0。",
  },
  {
    label: "Discord ops smoke",
    value: "已通過",
    note: "/ops status 與 /ops attention-list 已通過；這不代表 Email 或白帳號 E2E 已通過。",
  },
  {
    label: "GAS Email provider",
    value: "Smoke PASS",
    note: "已驗證 provider 可以寄出驗證信；這不代表 Portal 完整寄信流程或 external staging 已通過。",
  },
  {
    label: "Portal runtime",
    value: "本機驗證完成",
    note: "Same-origin join、Case ID lookup、session issuer 與 synthetic staging 已通過；尚未進入 external staging。",
  },
  {
    label: "數學系網站",
    value: "尚未授權掛載",
    note: "目前沒有 production hosting；網站與 API 都還沒交付到系網。",
  },
];
---

<BaseLayout
  title="建造與系統狀態"
  description="系統管理員使用的建置清單與監控入口。"
  requiredRole="admin"
>
  <div class="shell stack section" style="--stack-gap: var(--space-7)">
    <header class="status-intro">
      <div>
        <p><a href={withBase("access/")}>內部工作區</a> / 建造與系統狀態</p>
        <h1>建造與系統狀態</h1>
        <p>
          v13 Bot 已上線，GAS provider smoke 已通過。Portal 仍在本機與 synthetic
          staging 階段；external staging 尚未開始，系網掛載也未授權。
        </p>
      </div>
      <span class="mode-badge">等待 external staging</span>
    </header>

    <section aria-labelledby="snapshot-title">
      <div class="section-heading">
        <div>
          <h2 id="snapshot-title">目前系統狀態</h2>
          <p>
            頁面核對：2026-08-28。v13 Bot 狀態來自遠端交接與 Discord ops
            smoke，GAS provider 已另行完成實寄測試。Portal 尚未進入 external
            staging，也未連接 production SQLite；Case ID 狀態查詢目前只在本機與
            synthetic 環境測試。
          </p>
        </div>
      </div>
      <dl class="monitor-grid">
        {
          monitorCards.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
              <p>{item.note}</p>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="gates-title">
      <div class="section-heading">
        <div>
          <h2 id="gates-title">Portal 發布檢查</h2>
          <p>
            Bot 與寄信 provider 已各自通過目前的檢查，但 Portal hosting
            仍須另行測試與授權。
          </p>
        </div>
      </div>
      <ol class="gate-list">
        {
          buildGates.map((gate) => (
            <li data-status={gate.status}>
              <span class="gate-symbol" aria-hidden="true">
                {gate.status === "DONE"
                  ? "✓"
                  : gate.status === "IN_PROGRESS"
                    ? "◐"
                    : "○"}
              </span>
              <div>
                <h3>{gate.label}</h3>
                <p>{gate.note}</p>
              </div>
              <strong>
                {gate.status === "DONE"
                  ? "完成"
                  : gate.status === "IN_PROGRESS"
                    ? "進行中"
                    : "待處理"}
              </strong>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="transition-note" aria-labelledby="monitor-title">
      <div>
        <h2 id="monitor-title">完成建置後的監控內容</h2>
        <p>
          屆時只顯示服務健康狀態、資料更新時間、待處理工作量、最近發布、備份與還原驗證，以及需要人工注意的事項。不顯示學生內容、ID、檔案路徑、完整錯誤訊息或機密資料。
        </p>
      </div>
      <span aria-label="尚未切換">尚未啟用</span>
    </section>

    <details class="source-note">
      <summary>事實來源與更新規則</summary>
      <p>
        系統現況以程式碼儲存庫、最新交接與僅限管理員使用的
        <code>/ops status</code> 安全摘要交叉核對。更新本頁後，舊快照移入封存區，不與現況並列。
      </p>
    </details>
  </div>
</BaseLayout>

<style>
  .status-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .status-intro > div {
    max-width: var(--reading-width);
  }

  .mode-badge {
    padding: var(--space-2) var(--space-4);
    border: var(--border-thin) solid var(--color-warning-border);
    border-radius: 999px;
    background: var(--color-warning-bg);
    font-weight: 800;
  }

  .monitor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    margin: 0;
    gap: var(--space-3);
  }

  .monitor-grid > div {
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-low);
  }

  .monitor-grid dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .monitor-grid dd {
    margin: var(--space-2) 0;
    color: var(--color-action);
    font-size: var(--font-size-lg);
    font-weight: 800;
  }

  .monitor-grid p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gate-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .gate-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .gate-list h3,
  .gate-list p {
    margin-bottom: var(--space-1);
  }

  .gate-list li > strong {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gate-symbol {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: var(--border-thin) solid currentColor;
    border-radius: 50%;
    color: var(--color-neutral-border);
    font-weight: 850;
  }

  .gate-list li[data-status="DONE"] .gate-symbol {
    background: var(--color-success-bg);
    color: var(--color-success-border);
  }

  .gate-list li[data-status="IN_PROGRESS"] .gate-symbol {
    background: var(--color-warning-bg);
    color: var(--color-warning-border);
  }

  .transition-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-action);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .transition-note > div {
    max-width: var(--reading-width);
  }

  .transition-note > span {
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--color-neutral-bg);
    color: var(--color-text-muted);
    font-weight: 750;
  }

  .source-note {
    max-width: var(--reading-width);
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .source-note summary {
    cursor: pointer;
    font-weight: 750;
  }

  .source-note p {
    padding-top: var(--space-3);
  }

  @media (max-width: 34rem) {
    .gate-list li {
      grid-template-columns: auto 1fr;
    }

    .gate-list li > strong {
      grid-column: 2;
    }
  }
</style>
