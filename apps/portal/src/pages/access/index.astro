---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
---

<BaseLayout
  title="內部登入"
  description="本機助教、教師與系統管理員工作區登入。"
  currentPath="access"
>
  <div class="access-shell shell" data-local-access>
    <header class="access-intro">
      <h1>教學團隊登入</h1>
      <p>
        助教與教師以教學審核者身份登入；第一位本機管理員擁有系統管理權限。學生與一般訪客不需登入。
      </p>
    </header>

    <section class="access-roles" aria-labelledby="access-roles-title">
      <h2 id="access-roles-title" class="visually-hidden">兩種內部權限</h2>
      <article>
        <h3>助教／教師</h3>
        <p>審核學生與訪客申請、查看教學團隊與系統狀態。</p>
      </article>
      <article>
        <h3>系統管理員</h3>
        <p>包含教學審核權限，並可新增審核者、處理例外、設定與可逆封存。</p>
      </article>
    </section>

    <section class="access-card" data-access-view="bootstrap" hidden>
      <div>
        <h2>建立第一位系統管理員</h2>
        <p>
          這個步驟只會在本機尚無帳號時出現。瀏覽器不保存明碼，只保存帳號摘要、salt
          與 PBKDF2 密碼雜湊。
        </p>
      </div>
      <form data-bootstrap-form>
        <label>
          <span>系統管理員帳號</span>
          <input name="accountId" autocomplete="username" required />
        </label>
        <label>
          <span>密碼</span>
          <input
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </label>
        <label>
          <span>再輸入一次</span>
          <input
            name="passwordConfirmation"
            type="password"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </label>
        <button type="submit">建立本機系統管理員</button>
        <p class="access-message" data-bootstrap-message aria-live="polite">
          至少 6 個字元，不可與帳號相同；正式上線前仍須改用伺服器端驗證。
        </p>
      </form>
    </section>

    <section class="access-card" data-access-view="login">
      <nav class="role-tabs" aria-label="選擇登入身份">
        <a href={withBase("access/?role=staff")} data-role-tab="staff"
          >助教／教師</a
        >
        <a href={withBase("access/?role=admin")} data-role-tab="admin"
          >系統管理員</a
        >
      </nav>
      <div>
        <h2><span data-login-role-label>系統管理員</span>登入</h2>
        <p>請使用已建立的本機帳號。</p>
      </div>
      <form data-login-form>
        <input type="hidden" name="expectedRole" />
        <label>
          <span>帳號</span>
          <input name="accountId" autocomplete="username" required />
        </label>
        <label>
          <span>密碼</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button type="submit"
          >登入<span data-login-role-label>系統管理員</span>工作區</button
        >
        <p class="access-message" data-login-message aria-live="polite">
          請使用已建立的本機帳號登入。
        </p>
      </form>
      <details class="access-maintenance">
        <summary>這個瀏覽器仍是舊測試帳號？</summary>
        <p>
          可先把舊身份資料移到瀏覽器內的暫存區，再重新建立第一位管理員；不會直接刪除舊資料。
        </p>
        <button
          class="button button--secondary"
          type="button"
          data-reinitialize-access
        >
          暫存舊身份並重新初始化
        </button>
      </details>
    </section>

    <section class="access-card" data-access-view="force-change" hidden>
      <h2>請先更改一次性密碼</h2>
      <p>助教帳號的初始密碼與帳號相同，更改後才會進入工作區。</p>
      <form data-force-change-form>
        <label>
          <span>新密碼</span>
          <input
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </label>
        <label>
          <span>再輸入一次</span>
          <input
            name="passwordConfirmation"
            type="password"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </label>
        <button type="submit">儲存後登入</button>
        <p class="access-message" data-force-change-message aria-live="polite">
          至少 6 個字元，不可與帳號相同。
        </p>
      </form>
    </section>

    <section
      class="access-card access-card--wide"
      data-access-view="account"
      hidden
    >
      <div class="account-heading">
        <div>
          <h2><span data-current-role>內部</span>工作區</h2>
        </div>
        <button
          class="button button--secondary"
          type="button"
          data-local-signout
        >
          登出
        </button>
      </div>

      <section class="release-gate" data-tester-window hidden>
        <div class="release-gate__heading">
          <div>
            <p class="eyebrow">DC Platform Beta</p>
            <h3>註冊開放控制</h3>
          </div>
          <strong data-test-window-state>尚未開放</strong>
        </div>
        <p class="release-gate__detail" data-test-window-detail>
          可開放 30 分鐘測試，或持續開放至管理員手動關閉。
        </p>
        <label class="release-gate__audience">
          <input type="checkbox" data-test-window-audience checked />
          <span>安全內測：限臺大校內網路／SSL VPN</span>
        </label>
        <p class="release-gate__note">
          正式限制由入口伺服器依連線來源執行；本機只預覽開放狀態。學生、訪客與教學團隊都可測試。
        </p>
        <div class="cluster release-gate__actions">
          <button type="button" data-open-test-window>臨時開放 30 分鐘</button>
          <button type="button" data-open-continuous-window>持續開放</button>
          <button
            type="button"
            class="button button--secondary"
            data-close-test-window>關閉註冊</button
          >
          <a class="button button--quiet" href={withBase("join/")}>預覽註冊頁</a
          >
        </div>
      </section>

      <div class="tool-links" aria-label="內部工具">
        <a href={withBase("team/registrations/")}>
          <strong>加入申請</strong><span>審核學生與訪客資格</span>
        </a>
        <a href={withBase("team/")}>
          <strong>教學團隊</strong><span>查看身份與責任</span>
        </a>
        <a href={withBase("status/")}>
          <strong>系統狀態</strong><span>確認目前可用服務</span>
        </a>
        <a href={withBase("sqlite-lab/")} data-role-card="admin">
          <strong>SQLite 學習</strong><span>管理員資料架構教程</span>
        </a>
        <a href={withBase("team/#case-reference")} data-role-card="admin">
          <strong>案件狀態說明</strong><span
            >查看流程、隱私、同步與例外狀況</span
          >
        </a>
        <a href="#account-management" data-role-card="admin">
          <strong>身份與權限</strong><span>新增教學審核者或系統管理員</span>
        </a>
      </div>

      <details class="development-tools" data-role-card="admin">
        <summary>開發工具</summary>
        <a href={withBase("components/")}>
          <strong>介面狀態檢查</strong>
          <span>檢查按鈕、表單、提示訊息與案件狀態</span>
        </a>
      </details>

      <div class="account-forms" id="account-management">
        <form data-change-password-form>
          <h3>更改我的密碼</h3>
          <label
            ><span>帳號</span><input
              name="accountId"
              autocomplete="username"
              required
            /></label
          >
          <label
            ><span>目前密碼</span><input
              name="currentPassword"
              type="password"
              autocomplete="current-password"
              required
            /></label
          >
          <label
            ><span>新密碼</span><input
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="6"
              required
            /></label
          >
          <label
            ><span>再輸入一次</span><input
              name="passwordConfirmation"
              type="password"
              autocomplete="new-password"
              minlength="6"
              required
            /></label
          >
          <button type="submit">更新密碼</button>
          <p
            class="access-message"
            data-change-password-message
            aria-live="polite"
          >
          </p>
        </form>

        <form data-add-account-form data-admin-only>
          <h3>新增本機身份</h3>
          <label
            ><span>帳號／學號</span><input
              name="accountId"
              autocomplete="off"
              required
            /></label
          >
          <label>
            <span>身份</span>
            <select name="role">
              <option value="staff">助教／教師</option>
              <option value="admin">系統管理員</option>
            </select>
          </label>
          <button type="submit">新增身份</button>
          <p>初始密碼與帳號相同；首次登入必須更改。</p>
          <p class="access-message" data-add-account-message aria-live="polite">
          </p>
        </form>
      </div>

      <p class="security-note">
        本機只儲存帳號摘要、個別 salt、PBKDF2
        密碼雜湊與身份。這個靜態原型不是正式授權邊界，上線前必須改由伺服器端驗證與限權。
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import "../../scripts/local-access";
</script>

<style>
  .access-shell {
    display: grid;
    width: min(calc(100% - 2 * var(--space-4)), 72rem);
    padding-block: clamp(2.5rem, 7vw, 5rem);
    gap: var(--space-6);
  }

  .access-intro {
    max-width: 38rem;
    text-align: center;
    justify-self: center;
  }

  .access-roles {
    width: 100%;
    max-width: 60rem;
    justify-self: center;
  }

  .access-card {
    display: grid;
    width: 100%;
    max-width: 32rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-low);
    gap: var(--space-5);
    justify-self: center;
  }

  .access-roles {
    display: grid;
    gap: var(--space-3);
  }

  .access-roles article {
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .access-roles article:last-child {
    border-top: 0.3rem solid var(--color-accent);
  }

  .access-roles :is(h3, p:last-child) {
    margin-bottom: 0;
  }

  .access-maintenance {
    padding-top: var(--space-3);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .access-maintenance summary {
    cursor: pointer;
    font-weight: 750;
  }

  .access-card--wide {
    max-width: none;
  }

  .role-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: var(--space-1);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    gap: var(--space-1);
  }

  .role-tabs a {
    padding: var(--space-2) var(--space-3);
    border-radius: calc(var(--radius-md) - 0.15rem);
    text-align: center;
    text-decoration: none;
  }

  .role-tabs a[aria-current="page"] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-low);
    font-weight: 800;
  }

  form,
  form label {
    display: grid;
    gap: var(--space-2);
  }

  form {
    gap: var(--space-4);
  }

  form label span {
    font-weight: 750;
  }

  .access-message {
    min-height: 1.6rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .access-message[data-state="error"] {
    color: var(--color-danger-border);
  }

  .access-message[data-state="success"] {
    color: var(--color-success-border);
  }

  .account-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: center;
  }

  .tool-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    border-block: var(--border-thin) solid var(--color-border);
  }

  .release-gate {
    display: grid;
    padding-block: var(--space-4);
    border-block: var(--border-thin) solid var(--color-border);
    gap: var(--space-4);
  }

  .release-gate__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .release-gate__heading :is(p, h3) {
    margin-bottom: 0;
  }

  .release-gate__heading > strong {
    color: var(--color-accent);
    white-space: nowrap;
  }

  .release-gate__detail,
  .release-gate__note {
    margin: 0;
    color: var(--color-text-muted);
  }

  .release-gate__audience {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 750;
  }

  .release-gate__note {
    font-size: var(--font-size-sm);
  }

  .release-gate__actions {
    margin: 0;
  }

  .tool-links a {
    display: grid;
    padding: var(--space-4) var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    gap: var(--space-1);
  }

  .tool-links a:hover {
    background: var(--color-surface-muted);
  }

  .tool-links span {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .development-tools {
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .development-tools summary {
    padding: var(--space-3) 0;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--font-size-sm);
    font-weight: 750;
  }

  .development-tools a {
    display: grid;
    padding: 0 0 var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    gap: var(--space-1);
  }

  .development-tools span {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  :global(html[data-access-role="staff"]) [data-role-card="admin"] {
    display: none;
  }

  .account-forms {
    display: grid;
    gap: var(--space-6);
  }

  .account-forms form {
    align-content: start;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .security-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 46rem) {
    .access-roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .account-forms {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 38rem) {
    .release-gate__heading {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
