---
import Alert from "../components/Alert.astro";
import ButtonLink from "../components/ButtonLink.astro";
import CaseSearch from "../components/CaseSearch.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fixtureCaseLookupAdapter } from "../lib/fixture-case-adapter";
import { withBase } from "../lib/paths";

const caseStatuses = await fixtureCaseLookupAdapter.listCaseStatuses();
const isPublicBuild = import.meta.env.PUBLIC_PORTAL_BUILD === "true";
---

<BaseLayout
  title="首頁"
  description="加入臺大微積分 Discord、在伺服器提問，或用案號查詢案件進度。"
>
  <section class="hero">
    <div class="shell hero__content">
      <p class="eyebrow">臺大微積分教學支援</p>
      <h1>充實的課程，需要專業的後盾。</h1>
      <p>
        加入課程
        Discord，和同學、助教與教師一起處理數學問題、課務系統與值得延伸的討論。
      </p>
      <div class="cluster">
        <ButtonLink href={withBase("join/")}>加入 Discord 伺服器</ButtonLink>
        <ButtonLink href={withBase("guide/")} variant="secondary"
          >看看怎麼提問</ButtonLink
        >
      </div>
    </div>
  </section>

  <div class="shell stack section" style="--stack-gap: var(--space-7)">
    <Alert title="正式課務以各班 NTU COOL 為準" tone="danger">
      <p>教材、作業、成績、期限、公告與課程政策，以各班 NTU COOL 為準。</p>
    </Alert>

    <section class="stack" aria-labelledby="start-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">從這裡開始</p>
          <h2 id="start-title">找到你現在需要的入口</h2>
        </div>
      </div>
      <div class="action-grid action-grid--compact">
        <a class="action-tile" href={withBase("join/")}>
          <span class="action-tile__number">加入</span>
          <h3>進入課程伺服器</h3>
          <p>送出學生或訪客申請，等待 Course Manager 核准權限。</p>
        </a>
        <a class="action-tile" href={withBase("guide/")}>
          <span class="action-tile__number">提問</span>
          <h3>在 Discord 發問</h3>
          <p>公開問題直接發文；隱密支援用指令建立專屬空間。</p>
        </a>
        <a class="action-tile" href={withBase("cases/")}>
          <span class="action-tile__number">追蹤</span>
          <h3>查詢案件進度</h3>
          <p>用 Bot 私訊提供的案號查看狀態，再回 Discord 閱讀內容。</p>
        </a>
      </div>
    </section>

    <section class="stack" aria-labelledby="lookup-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">案件查詢</p>
          <h2 id="lookup-title">已經有案號？</h2>
          <p>
            一般與隱密案件都從同一個地方查詢；網頁只顯示進度，不呈現提問內容。
          </p>
        </div>
      </div>
      <CaseSearch
        cases={isPublicBuild ? [] : caseStatuses}
        inputId="home-case-number"
        enabled={!isPublicBuild}
      />
    </section>

    <section class="platform-strip" aria-labelledby="platform-title">
      <h2 id="platform-title">每個地方，只做它最擅長的事</h2>
      <div class="grid grid--auto">
        <p>
          <strong>各班 NTU COOL</strong><br />正式教材、作業、成績、期限與公告。
        </p>
        <p><strong>Discord</strong><br />提問、回覆、討論、隱密支援與通知。</p>
        <p><strong>本網站</strong><br />加入申請、使用說明與簡要案件進度。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero__content {
    display: grid;
    gap: var(--space-4);
  }

  .hero__content p:not(.eyebrow) {
    max-width: 39rem;
    font-size: var(--font-size-lg);
  }

  .action-grid--compact .action-tile {
    min-height: 0;
  }

  .action-grid--compact .action-tile h3 {
    margin-top: var(--space-5);
  }

  @media (min-width: 58rem) {
    .action-grid--compact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
