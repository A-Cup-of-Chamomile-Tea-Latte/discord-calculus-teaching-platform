---
import { readFileSync } from "node:fs";

import Alert from "../../components/Alert.astro";
import FormField from "../../components/FormField.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  discordInviteUrl,
  sameOriginEndpointPath,
} from "../../lib/join-application";
import { withBase } from "../../lib/paths";

interface RegistrationSection {
  classCode: string;
  canonicalClassLabel: string;
  moduleCode: string;
  status: string;
  instructorRef: string;
}

interface Instructor {
  instructorRef: string;
  publicDisplayName: string;
}

const academicSpec = JSON.parse(
  readFileSync(
    new URL(
      "../../../../../config/academic/115-1/course-operations.yaml",
      import.meta.url,
    ),
    "utf8",
  ),
) as {
  sections: RegistrationSection[];
  peopleDirectory: { instructors: Instructor[] };
};
const instructorNames = new Map(
  academicSpec.peopleDirectory.instructors.map((instructor) => [
    instructor.instructorRef,
    instructor.publicDisplayName,
  ]),
);
const activeSections = academicSpec.sections.filter(
  (section) => section.status === "ACTIVE",
);
const isPublicBuild = import.meta.env.PUBLIC_PORTAL_BUILD === "true";
const applicationEndpoint = sameOriginEndpointPath(
  import.meta.env.PUBLIC_JOIN_APPLICATION_ENDPOINT,
);
const sessionEndpoint = sameOriginEndpointPath(
  import.meta.env.PUBLIC_PORTAL_SESSION_ENDPOINT,
);
const applicationConnected = Boolean(applicationEndpoint && sessionEndpoint);
const courseDiscordInvite = discordInviteUrl(
  import.meta.env.PUBLIC_DISCORD_INVITE_URL,
);
---

<BaseLayout
  title="加入 Discord 伺服器"
  description="申請臺大微積分 Discord 的學生或訪客權限。"
  currentPath="join"
>
  <div class="join-shell shell stack section">
    <header class="join-intro">
      <p><a href={withBase("")}>首頁</a> / 加入與設定</p>
      <h1>2 分鐘加入 Discord 伺服器</h1>
      <p>
        先加入課程伺服器的等候區，再送出這份申請。Course Manager
        核對完成後，會套用課程權限並直接用 Discord 私訊通知你。
      </p>
    </header>

    <ol class="join-steps" aria-label="加入流程">
      <li><strong>1</strong><span>加入等候區</span></li>
      <li><strong>2</strong><span>送出申請</span></li>
      <li><strong>3</strong><span>收到私訊</span></li>
    </ol>

    <section class="discord-entry" aria-labelledby="discord-entry-title">
      <div class="discord-entry__intro">
        <h2 id="discord-entry-title">先加入課程 Discord</h2>
        <p>
          建議使用 Discord
          APP，通知與私訊比較不容易漏掉。加入等候區後，再回到本頁填寫課程身分。
        </p>
      </div>
      {
        courseDiscordInvite ? (
          <a
            class="button discord-entry__primary"
            href={courseDiscordInvite}
            target="_blank"
            rel="noreferrer"
          >
            開啟課程邀請
          </a>
        ) : (
          <p class="discord-entry__pending" role="status">
            課程邀請將在 Beta 開放時提供。
          </p>
        )
      }
      <div class="discord-entry__alternatives">
        <a
          class="button button--secondary"
          href="https://discord.com/download"
          target="_blank"
          rel="noreferrer"
        >
          下載 Discord APP（推薦）
        </a>
        <a href="https://discord.com/app" target="_blank" rel="noreferrer">
          暫時使用網頁版
        </a>
      </div>
      <details class="discord-entry__help">
        <summary>邀請沒有開啟，或開到錯的帳號？</summary>
        <ul>
          <li>先確認 Discord APP 已登入準備加入課程的帳號，再重新開啟邀請。</li>
          <li>若 APP 沒有反應，可先用網頁版登入，再回來點一次課程邀請。</li>
          <li>
            加入後應先看到課程等候區；尚未完成審核時看不到班級頻道是正常的。
          </li>
        </ul>
      </details>
    </section>

    <Alert title="送出前，先確認 Discord 帳號">
      <p>
        請使用準備加入課程的帳號進入伺服器。若找不到成員，申請會保留在「等待加入伺服器」，不會被拒絕或刪除。
      </p>
    </Alert>

    {
      !isPublicBuild && (
        <p class="review-only">
          目前是測試環境，只會檢查欄位並顯示確認畫面，不會送出申請。
        </p>
      )
    }

    <section
      class="application-panel"
      data-join-application
      data-review-mode={String(!isPublicBuild)}
      data-session-endpoint={sessionEndpoint ?? ""}
      aria-labelledby="join-form-title"
    >
      {
        !isPublicBuild && (
          <div
            class="test-registration-notice"
            data-test-registration-notice
            data-state="closed"
            role="status"
          >
            <strong data-test-registration-title>測試註冊尚未開放</strong>
            <span data-test-registration-detail>
              請由系統管理員在「教學團隊登入」開放 Beta 註冊。
            </span>
          </div>
        )
      }

      <div>
        <h2 id="join-form-title">填寫課程身分</h2>
      </div>

      <form
        class="prototype-form"
        hidden={!isPublicBuild}
        novalidate
        action={applicationEndpoint}
        method="post"
      >
        <div
          class="form-error-summary"
          data-form-errors
          role="alert"
          tabindex="-1"
          hidden
        >
          <h3>有幾個欄位需要再確認</h3>
          <p>已輸入的內容都還在，可以直接修改：</p>
          <ul></ul>
        </div>

        <fieldset class="choice-group">
          <legend>申請身分 *</legend>
          <label data-identity-choice="STUDENT">
            <input type="radio" name="identityType" value="STUDENT" checked />
            臺大學生
          </label>
          <label data-identity-choice="GUEST">
            <input type="radio" name="identityType" value="GUEST" />
            訪客
          </label>
          {
            !isPublicBuild && (
              <label data-identity-choice="TEACHING_TEAM">
                <input type="radio" name="identityType" value="TEACHING_TEAM" />
                助教／教師
              </label>
            )
          }
          <p class="field-error" data-field-error="identityType" hidden></p>
        </fieldset>

        <FormField
          forId="join-discord-username"
          label="Discord 使用者名稱（不前綴 @）"
          hint="例如 dingding124816。請填寫顯示名稱下方、可用來找到你的那一行。"
          required
        >
          <input
            id="join-discord-username"
            name="discordUsername"
            type="text"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            maxlength="32"
            placeholder="dingding124816"
            aria-describedby="join-discord-username-hint join-discord-username-error"
          />
          <p
            id="join-discord-username-error"
            class="field-error"
            data-field-error="discordUsername"
            hidden
          >
          </p>
        </FormField>

        <details class="username-help">
          <summary>怎麼找到 Discord 使用者名稱？</summary>
          <div>
            <p>
              <strong>電腦版：</strong
              >點自己的頭像，在個人資料中直接複製使用者名稱。
            </p>
            <p>
              <strong>手機版：</strong>開啟個人資料，查看顯示名稱下方那一行。
            </p>
          </div>
        </details>

        <div class="identity-fields" data-identity-fields="STUDENT">
          <FormField
            forId="join-ntu-email"
            label="NTU Mail"
            hint="用來核對臺大學生身分。"
            required
          >
            <input
              id="join-ntu-email"
              name="ntuEmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="student@ntu.edu.tw"
              aria-describedby="join-ntu-email-hint join-ntu-email-error"
            />
            <p
              id="join-ntu-email-error"
              class="field-error"
              data-field-error="ntuEmail"
              hidden
            >
            </p>
          </FormField>

          <FormField
            forId="join-class-code"
            label="班別"
            hint="Course Manager 會依此套用課程與班級權限。"
            required
          >
            <select
              id="join-class-code"
              name="classCode"
              aria-describedby="join-class-code-hint join-class-code-error"
            >
              <option value="">請選擇</option>
              {
                activeSections.map((section) => (
                  <option value={section.classCode}>
                    {section.moduleCode}－{section.canonicalClassLabel}－
                    {instructorNames.get(section.instructorRef)}老師
                  </option>
                ))
              }
            </select>
            <p
              id="join-class-code-error"
              class="field-error"
              data-field-error="classCode"
              hidden
            >
            </p>
          </FormField>

          <FormField
            forId="join-contact-gmail"
            label="聯絡 Gmail"
            hint="選填；主要審核結果仍由 Discord 私訊通知。"
          >
            <input
              id="join-contact-gmail"
              name="contactGmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="name@gmail.com"
              aria-describedby="join-contact-gmail-hint join-contact-gmail-error"
            />
            <p
              id="join-contact-gmail-error"
              class="field-error"
              data-field-error="contactGmail"
              hidden
            >
            </p>
          </FormField>
        </div>

        <div class="identity-fields" data-identity-fields="GUEST" hidden>
          <Alert title="訪客申請會由教學團隊審核">
            <p>訪客不會取得學生班級角色；核准時會套用獨立的訪客權限。</p>
          </Alert>
          <FormField
            forId="join-guest-email"
            label="聯絡 Email"
            hint="訪客必填。"
            required
          >
            <input
              id="join-guest-email"
              name="guestEmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              aria-describedby="join-guest-email-hint join-guest-email-error"
            />
            <p
              id="join-guest-email-error"
              class="field-error"
              data-field-error="guestEmail"
              hidden
            >
            </p>
          </FormField>
          <FormField
            forId="join-guest-reason"
            label="來訪原因"
            hint="請簡短說明你的身分與想加入的原因。"
            required
          >
            <textarea
              id="join-guest-reason"
              name="guestReason"
              rows="4"
              maxlength="500"
              aria-describedby="join-guest-reason-hint join-guest-reason-error"
            ></textarea>
            <p
              id="join-guest-reason-error"
              class="field-error"
              data-field-error="guestReason"
              hidden
            >
            </p>
          </FormField>
        </div>

        {
          !isPublicBuild && (
            <div
              class="identity-fields"
              data-identity-fields="TEACHING_TEAM"
              hidden
            >
              <Alert title="教學團隊申請需由管理員核准">
                <p>這裡只驗證申請流程；正式權限仍由系統管理員核准建立。</p>
              </Alert>
              <FormField
                forId="join-staff-role"
                label="教學身分"
                hint="請選擇這學期在課程中的身分。"
                required
              >
                <select
                  id="join-staff-role"
                  name="staffRole"
                  aria-describedby="join-staff-role-hint join-staff-role-error"
                >
                  <option value="">請選擇</option>
                  <option value="TA">助教</option>
                  <option value="INSTRUCTOR">教師</option>
                </select>
                <p
                  id="join-staff-role-error"
                  class="field-error"
                  data-field-error="staffRole"
                  hidden
                />
              </FormField>
              <FormField
                forId="join-staff-email"
                label="臺大信箱"
                hint="可使用 @ntu.edu.tw 或臺大單位的子網域信箱。"
                required
              >
                <input
                  id="join-staff-email"
                  name="staffEmail"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  placeholder="name@ntu.edu.tw"
                  aria-describedby="join-staff-email-hint join-staff-email-error"
                />
                <p
                  id="join-staff-email-error"
                  class="field-error"
                  data-field-error="staffEmail"
                  hidden
                />
              </FormField>
              <FormField
                forId="join-staff-class-code"
                label="主要負責班別"
                hint="先選一班驗證介面；正式權限可再由管理員調整。"
                required
              >
                <select
                  id="join-staff-class-code"
                  name="staffClassCode"
                  aria-describedby="join-staff-class-code-hint join-staff-class-code-error"
                >
                  <option value="">請選擇</option>
                  {activeSections.map((section) => (
                    <option value={section.classCode}>
                      {section.moduleCode}－{section.canonicalClassLabel}－
                      {instructorNames.get(section.instructorRef)}老師
                    </option>
                  ))}
                </select>
                <p
                  id="join-staff-class-code-error"
                  class="field-error"
                  data-field-error="staffClassCode"
                  hidden
                />
              </FormField>
            </div>
          )
        }

        <label class="rules-check">
          <input type="checkbox" name="rulesPrivacy" value="yes" />
          <span>
            我已閱讀<a href={withBase("guide/")}>使用與隱私說明</a>，也了解
            Discord 的伺服器暱稱不會隱藏全域帳號資訊。*
          </span>
        </label>
        <p class="field-error" data-field-error="rulesPrivacy" hidden></p>

        <div class="form-actions">
          <button
            type="submit"
            disabled={isPublicBuild && !applicationConnected}
          >
            {
              isPublicBuild && !applicationConnected
                ? "申請服務接線中"
                : "送出申請"
            }
          </button>
        </div>
      </form>

      {
        isPublicBuild && (
          <p data-join-backend-state role="status" hidden>
            申請已收到，請留意 Discord 私訊。
          </p>
        )
      }

      {
        isPublicBuild && (
          <dialog
            class="email-verification-dialog"
            data-email-verification-dialog
            aria-labelledby="email-verification-title"
          >
            <form class="email-verification-form" data-email-verification-form>
              <div>
                <h2 id="email-verification-title">驗證 Email</h2>
                <p data-email-verification-copy>
                  六位數驗證碼寄出後，請在這裡輸入。
                </p>
              </div>
              <label>
                <span>六位數驗證碼</span>
                <input
                  name="verificationCode"
                  type="text"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  pattern="[0-9]{6}"
                  minlength="6"
                  maxlength="6"
                  required
                />
              </label>
              <p
                class="field-error"
                data-email-verification-error
                role="alert"
                hidden
              />
              <div class="form-actions">
                <button type="submit">驗證並送出</button>
                <button
                  type="button"
                  class="button button--secondary"
                  data-email-verification-cancel
                >
                  取消
                </button>
              </div>
            </form>
          </dialog>
        )
      }

      {
        !isPublicBuild && (
          <section
            class="fixture-confirmation"
            data-join-confirmation
            tabindex="-1"
            hidden
          >
            <h2>申請資料格式已確認</h2>
            <dl>
              <div>
                <>
                  <dt>申請身分</dt>
                  <dd data-confirmation-identity />
                </>
              </div>
              <div>
                <>
                  <dt>Discord 使用者名稱</dt>
                  <dd data-confirmation-username />
                </>
              </div>
              <div>
                <>
                  <dt>班別／聯絡資料</dt>
                  <dd data-confirmation-detail />
                </>
              </div>
            </dl>
            <Alert title="尚未寫入申請佇列">
              <p>
                這是 reviewer build 的介面驗證；沒有傳送 Email、Discord
                私訊或正式資料。
              </p>
            </Alert>
            <button
              type="button"
              class="button button--secondary"
              data-join-reset
            >
              返回並清除表單
            </button>
          </section>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import "../../scripts/join-application-form";
</script>

<style>
  .join-shell {
    width: min(calc(100% - 2 * var(--space-4)), 48rem);
    gap: var(--space-5);
  }

  .join-intro {
    max-width: 42rem;
  }

  .join-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  .join-steps li {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-block-end: var(--border-strong) solid var(--color-border);
    color: var(--color-text-muted);
  }

  .join-steps strong {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-action);
    color: var(--color-action-text);
    font-size: var(--font-size-xs);
  }

  .application-panel {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1rem, 4vw, 2rem);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .discord-entry {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1rem, 4vw, 1.75rem);
    border: var(--border-thin) solid var(--color-border);
    border-inline-start: 0.4rem solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .discord-entry__intro :is(h2, p:last-child),
  .discord-entry__help ul {
    margin-bottom: 0;
  }

  .discord-entry__primary {
    justify-self: start;
  }

  .discord-entry__pending {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: 750;
  }

  .discord-entry__alternatives {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .discord-entry__help {
    padding-top: var(--space-3);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .discord-entry__help summary {
    cursor: pointer;
    font-weight: 750;
  }

  .discord-entry__help ul {
    padding-top: var(--space-3);
  }

  .test-registration-notice {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-block: var(--border-thin) solid var(--color-border);
    color: var(--color-text-muted);
    gap: var(--space-3);
  }

  .test-registration-notice strong {
    color: var(--color-text);
    white-space: nowrap;
  }

  .test-registration-notice[data-state="open"] strong {
    color: var(--color-success-border);
  }

  .identity-fields {
    display: grid;
    gap: var(--space-4);
  }

  .identity-fields[hidden] {
    display: none;
  }

  .username-help {
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .username-help summary {
    cursor: pointer;
    font-weight: 750;
  }

  .username-help div {
    padding-top: var(--space-3);
  }

  .username-help p:last-child {
    margin-bottom: 0;
  }

  .rules-check {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .rules-check a {
    margin-inline: 0.25em;
  }

  .email-verification-dialog {
    width: min(calc(100% - 2 * var(--space-4)), 30rem);
    padding: 0;
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }

  .email-verification-dialog::backdrop {
    background: color-mix(in srgb, var(--color-text) 48%, transparent);
  }

  .email-verification-form {
    display: grid;
    padding: clamp(1.25rem, 5vw, 2rem);
    gap: var(--space-4);
  }

  .email-verification-form label {
    display: grid;
    gap: var(--space-2);
  }

  .email-verification-form input {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-lg);
    letter-spacing: 0.2em;
  }

  @media (max-width: 38rem) {
    .test-registration-notice {
      display: grid;
    }
  }
</style>
