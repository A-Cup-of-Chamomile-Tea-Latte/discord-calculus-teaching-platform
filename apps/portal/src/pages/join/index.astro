---
import Alert from "../../components/Alert.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import FormField from "../../components/FormField.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
---

<BaseLayout
  title="加入與設定"
  description="約三分鐘完成課程身分、班別與隱私設定預覽。"
  currentPath="join"
>
  <div class="join-shell shell stack section">
    <header class="join-intro">
      <p><a href={withBase("")}>首頁</a> / 加入與設定</p>
      <p class="eyebrow">3 分鐘完成</p>
      <h1>加入課程與設定</h1>
      <p>依序確認身分、班別與隱私。目前是安全預覽，不會寄信或儲存資料。</p>
    </header>

    <ol class="join-steps" aria-label="加入設定步驟">
      <li><strong>1</strong><span>身分</span></li>
      <li><strong>2</strong><span>班別</span></li>
      <li><strong>3</strong><span>隱私</span></li>
    </ol>

    <p class="connection-note">
      <strong>Discord 連結尚未啟用。</strong> 本頁不會要求 token 或開啟 OAuth。
    </p>

    <section
      class="prototype-panel"
      data-fixture-form
      data-form-kind="join"
      aria-labelledby="join-form-title"
    >
      <div>
        <p class="fixture-marker">安全預覽 · 不會送出</p>
        <h2 id="join-form-title">建立設定預覽</h2>
        <p>重新整理後，這頁輸入的內容就會消失。</p>
      </div>

      <form class="prototype-form" novalidate>
        <div
          class="form-error-summary"
          data-form-errors
          role="alert"
          tabindex="-1"
          hidden
        >
          <h3>有幾個欄位需要再確認</h3>
          <p>已輸入的內容都還在，可以直接修改：</p>
          <ul></ul>
        </div>

        <FormField
          forId="join-ntu-email"
          label="NTU Email"
          hint="目前只檢查格式，不會寄信。"
          required
        >
          <input
            id="join-ntu-email"
            name="ntuEmail"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="student@ntu.edu.tw"
            aria-describedby="join-ntu-email-hint join-ntu-email-error"
          />
          <p
            id="join-ntu-email-error"
            class="field-error"
            data-field-error="ntuEmail"
            hidden
          >
          </p>
        </FormField>

        <FormField
          forId="join-contact-gmail"
          label="聯絡 Gmail"
          hint="選填，作為後續聯絡信箱。"
        >
          <input
            id="join-contact-gmail"
            name="contactGmail"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="name@gmail.com"
            aria-describedby="join-contact-gmail-hint join-contact-gmail-error"
          />
          <p
            id="join-contact-gmail-error"
            class="field-error"
            data-field-error="contactGmail"
            hidden
          >
          </p>
        </FormField>

        <FormField
          forId="join-class-code"
          label="班別"
          hint="用來分流課程問題與通知。"
          required
        >
          <select
            id="join-class-code"
            name="classCode"
            aria-describedby="join-class-code-hint join-class-code-error"
          >
            <option value="">請選擇</option>
            <option value="01">01 班</option>
            <option value="02">02 班</option>
          </select>
          <p
            id="join-class-code-error"
            class="field-error"
            data-field-error="classCode"
            hidden
          >
          </p>
        </FormField>

        <div class="alias-preview" aria-live="polite">
          <strong>課程代號預覽：</strong>
          <output data-alias-preview for="join-class-code">尚未選擇班別</output>
          <p>預覽會使用範例順序 042，不是正式指派。</p>
        </div>

        <fieldset class="choice-group">
          <legend>教學分析預設 *</legend>
          <p>這與作者顯示、是否能獲得回覆分開設定，之後仍可更改。</p>
          <label
            ><input
              type="radio"
              name="analysisPermission"
              value="INCLUDED"
              checked
            /> 允許教學分析</label
          >
          <label
            ><input type="radio" name="analysisPermission" value="EXCLUDED" /> 排除教學分析</label
          >
          <p class="field-error" data-field-error="analysisPermission" hidden>
          </p>
        </fieldset>

        <fieldset class="choice-group">
          <legend>安全與隱私確認</legend>
          <label>
            <input
              type="checkbox"
              name="dmRecommendation"
              value="yes"
              checked
            />
            我會檢查「允許來自同一伺服器成員的私人訊息」設定；建議關閉陌生 DM。
          </label>
          <label>
            <input type="checkbox" name="rulesPrivacy" value="yes" />
            我已閱讀規則與隱私說明，了解 server nickname 不會隱藏全域帳號資訊。*
          </label>
          <p class="field-error" data-field-error="rulesPrivacy" hidden></p>
        </fieldset>

        <div class="form-actions">
          <button type="submit">預覽我的設定</button>
          <ButtonLink href={withBase("guide/")} variant="secondary"
            >閱讀完整隱私指南</ButtonLink
          >
        </div>
      </form>

      <section
        class="fixture-confirmation"
        data-fixture-confirmation
        tabindex="-1"
        hidden
      >
        <p class="fixture-marker">預覽完成 · 未送出</p>
        <h2 data-confirmation-title>你的設定預覽已建立</h2>
        <p>參考編號：<strong data-confirmation-reference></strong></p>
        <dl data-confirmation-summary></dl>
        <Alert title="尚未建立帳號或送出資料">
          <p>這份預覽沒有連線 Discord、Email 或課程成員系統。</p>
        </Alert>
        <button
          type="button"
          class="button button--secondary"
          data-fixture-reset>返回並清除表單</button
        >
      </section>
    </section>
  </div>
</BaseLayout>

<script>
  import "../../scripts/fixture-forms";
</script>

<style>
  .join-shell {
    width: min(calc(100% - 2 * var(--space-4)), 48rem);
    gap: var(--space-5);
  }

  .join-intro {
    max-width: 40rem;
    text-align: center;
    margin-inline: auto;
  }

  .join-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  .join-steps li {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-block-end: var(--border-strong) solid var(--color-border);
    color: var(--color-text-muted);
  }

  .join-steps strong {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-action);
    color: var(--color-action-text);
    font-size: var(--font-size-xs);
  }

  .connection-note {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    font-size: var(--font-size-sm);
  }

  .prototype-panel {
    padding: clamp(1rem, 4vw, 2rem);
  }
</style>
