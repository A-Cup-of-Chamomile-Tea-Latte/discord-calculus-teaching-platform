---
import CaseSearch from "../../components/CaseSearch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fixtureCaseLookupAdapter } from "../../lib/fixture-case-adapter";
import { withBase } from "../../lib/paths";

const publicCases = await fixtureCaseLookupAdapter.listPublicCases();
---

<BaseLayout
  title="查詢一般案件"
  description="輸入案件編號，查看最新進度。"
  currentPath="cases"
>
  <div class="case-page shell stack section">
    <header class="case-intro">
      <p><a href={withBase("")}>首頁</a> / 案件查詢</p>
      <p class="eyebrow">案件進度</p>
      <h1>查案件</h1>
      <p>輸入案號，查看最新狀態。Private Support 不在這裡顯示。</p>
    </header>

    <CaseSearch cases={publicCases} inputId="case-number" syncUrl compact />

    <p class="case-help">
      案號會出現在建案完成頁、Discord 案件貼文與通知信中。目前為離線預覽。
    </p>
  </div>
</BaseLayout>

<style>
  .case-page {
    width: min(calc(100% - 2 * var(--space-4)), 46rem);
    gap: var(--space-5);
  }

  .case-intro {
    max-width: 36rem;
    text-align: center;
    margin-inline: auto;
  }

  .case-help {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
