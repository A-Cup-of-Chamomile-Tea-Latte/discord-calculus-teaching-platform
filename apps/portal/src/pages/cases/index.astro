---
import CaseSearch from "../../components/CaseSearch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fixtureCaseLookupAdapter } from "../../lib/fixture-case-adapter";
import { sameOriginEndpointPath } from "../../lib/join-application";
import { withBase } from "../../lib/paths";

const caseStatuses = await fixtureCaseLookupAdapter.listCaseStatuses();
const isPublicBuild = import.meta.env.PUBLIC_PORTAL_BUILD === "true";
const caseStatusEndpoint = sameOriginEndpointPath(
  import.meta.env.PUBLIC_CASE_STATUS_ENDPOINT,
);
const sessionEndpoint = sameOriginEndpointPath(
  import.meta.env.PUBLIC_PORTAL_SESSION_ENDPOINT,
);
const lookupConnected = Boolean(caseStatusEndpoint && sessionEndpoint);
---

<BaseLayout
  title="查詢案件"
  description="輸入案件編號，查看最新進度。"
  currentPath="cases"
>
  <div class="case-page shell stack section">
    <header class="case-intro">
      <p><a href={withBase("")}>首頁</a> / 案件查詢</p>
      <h1>查案件</h1>
      <p>一般與隱密案件都可以查；只顯示狀態、更新時間與是否已有回覆。</p>
    </header>

    <CaseSearch
      cases={isPublicBuild ? [] : caseStatuses}
      inputId="case-number"
      syncUrl
      compact
      enabled={!isPublicBuild || lookupConnected}
      endpoint={caseStatusEndpoint}
      sessionEndpoint={sessionEndpoint}
    />

    <p class="case-help">
      公開與隱密案件建立完成後，Bot 都會用 Discord 私訊提供案號與直達連結。
    </p>
  </div>
</BaseLayout>

<style>
  .case-page {
    width: min(calc(100% - 2 * var(--space-4)), 46rem);
    gap: var(--space-5);
  }

  .case-intro {
    max-width: 36rem;
    text-align: center;
    margin-inline: auto;
  }

  .case-help {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
