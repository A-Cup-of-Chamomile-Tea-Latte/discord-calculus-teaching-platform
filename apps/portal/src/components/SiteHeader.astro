---
interface NavItem {
  href: string;
  label: string;
  current?: boolean;
  minRole?: "staff" | "admin";
}

interface Props {
  homeHref: string;
  accessHref: string;
  navItems: NavItem[];
  showInternalAccess?: boolean;
}

const {
  homeHref,
  accessHref,
  navItems,
  showInternalAccess = true,
} = Astro.props;
const accessControlScript = `
  document.querySelectorAll("[data-local-signout]").forEach((button) => {
    button.addEventListener("click", () => {
      try { sessionStorage.removeItem("calculus-local-session-v1"); } catch {}
      window.location.reload();
    });
  });
`;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <div class="site-header__identity">
      <a class="site-header__brand" href={homeHref}>微積分教學支援</a>
      <span class="site-header__beta">測試版 Beta</span>
    </div>
    <nav aria-label="主要導覽">
      <ul>
        {
          navItems.map((item) => (
            <li data-min-role={item.minRole}>
              <a
                href={item.href}
                aria-current={item.current ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      showInternalAccess && (
        <div class="access-controls">
          <div
            class="access-links access-links--guest"
            aria-label="教學團隊登入"
          >
            <a href={accessHref}>教學團隊登入</a>
          </div>
          <div
            class="access-links access-links--signed-in"
            aria-label="已登入身份"
          >
            <a href={accessHref}>
              <span data-access-role-label>內部</span>工作區
            </a>
            <button type="button" class="access-signout" data-local-signout>
              登出
            </button>
          </div>
        </div>
      )
    }
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-thin) solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    padding-block: var(--space-3);
  }

  .site-header__brand {
    color: var(--color-text);
    font-size: clamp(1.45rem, 2.3vw, 1.85rem);
    font-weight: 800;
    letter-spacing: 0.015em;
    line-height: 1.15;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-action);
  }

  .site-header__identity {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .site-header__beta {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  nav {
    flex-basis: 100%;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
  }

  a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 800;
    text-decoration-thickness: 0.18em;
  }

  .access-links {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: var(--border-thin) solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .access-links a,
  .access-signout {
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 750;
    text-decoration: none;
  }

  .access-links a:hover,
  .access-signout:hover {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-low);
  }

  .access-links--signed-in {
    display: none;
  }

  html[data-access-role="staff"] .access-links--guest,
  html[data-access-role="admin"] .access-links--guest {
    display: none;
  }

  html[data-access-role="staff"] .access-links--signed-in,
  html[data-access-role="admin"] .access-links--signed-in {
    display: flex;
  }

  html[data-access-role="staff"] [data-access-role-label]::before {
    content: "助教／教師";
  }

  html[data-access-role="admin"] [data-access-role-label]::before {
    content: "系統管理員";
  }

  [data-access-role-label] {
    font-size: 0;
  }

  [data-access-role-label]::before {
    font-size: var(--font-size-sm);
  }

  @media (min-width: 50rem) {
    nav {
      flex-basis: auto;
      margin-inline-start: auto;
    }

    .access-controls {
      flex-basis: auto;
    }
  }
</style>

{showInternalAccess && <script is:inline set:html={accessControlScript} />}
