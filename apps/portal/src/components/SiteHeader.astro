---
interface NavItem {
  href: string;
  label: string;
  current?: boolean;
}

interface Props {
  homeHref: string;
  navItems: NavItem[];
  modeLabel?: string;
}

const { homeHref, navItems, modeLabel = "本機展示版" } = Astro.props;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href={homeHref}>微積分教學支援</a>
    <span class="site-header__mode">{modeLabel}</span>
    <nav aria-label="主要導覽">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="theme-switcher" aria-label="外觀選擇">
      <button type="button" data-theme-option="formal" aria-pressed="true"
        >課程正式</button
      >
      <button type="button" data-theme-option="student" aria-pressed="false"
        >學生友善</button
      >
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-thin) solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    color: var(--color-text);
    font-size: var(--font-size-lg);
    font-weight: 800;
    text-decoration: none;
  }

  .site-header__mode {
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin) solid var(--color-warning-border);
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  nav {
    flex-basis: 100%;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
    list-style: none;
  }

  a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 800;
    text-decoration-thickness: 0.18em;
  }

  .theme-switcher {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: var(--border-thin) solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .theme-switcher button {
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .theme-switcher button[aria-pressed="true"] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-low);
  }

  @media (min-width: 50rem) {
    nav {
      flex-basis: auto;
      margin-inline-start: auto;
    }

    .theme-switcher {
      flex-basis: auto;
    }
  }
</style>

<script>
  import "../scripts/theme-toggle";
</script>
