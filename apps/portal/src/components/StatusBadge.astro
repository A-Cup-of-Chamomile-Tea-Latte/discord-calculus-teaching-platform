---
type Status =
  | "OPEN"
  | "WAITING_FOR_STUDENT"
  | "ANSWERED"
  | "ESCALATED"
  | "TEMPORARILY_CLOSED"
  | "CLOSED"
  | "REOPENED";

interface Props {
  status: Status;
}

const { status } = Astro.props;
const labels: Record<Status, { symbol: string; label: string; tone: string }> =
  {
    OPEN: { symbol: "○", label: "Open · 待接手", tone: "info" },
    WAITING_FOR_STUDENT: {
      symbol: "↩",
      label: "Idle · 等待學生",
      tone: "warning",
    },
    ANSWERED: { symbol: "✓", label: "Tracked · 已接手", tone: "success" },
    ESCALATED: { symbol: "↑", label: "Tracked · 已升級", tone: "danger" },
    TEMPORARILY_CLOSED: {
      symbol: "◐",
      label: "Idle · 提醒中",
      tone: "warning",
    },
    CLOSED: { symbol: "■", label: "Closed · 已結案", tone: "neutral" },
    REOPENED: { symbol: "↻", label: "Tracked · 新循環", tone: "info" },
  };
const value = labels[status];
---

<span class="badge" data-tone={value.tone} title={status}>
  <span aria-hidden="true">{value.symbol}</span>
  <span>{value.label}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--border-thin) solid var(--state-border);
    border-radius: 999px;
    background: var(--state-bg);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  [data-tone="info"] {
    --state-bg: var(--color-info-bg);
    --state-border: var(--color-info-border);
  }

  [data-tone="warning"] {
    --state-bg: var(--color-warning-bg);
    --state-border: var(--color-warning-border);
  }

  [data-tone="success"] {
    --state-bg: var(--color-success-bg);
    --state-border: var(--color-success-border);
  }

  [data-tone="danger"] {
    --state-bg: var(--color-danger-bg);
    --state-border: var(--color-danger-border);
  }

  [data-tone="neutral"] {
    --state-bg: var(--color-neutral-bg);
    --state-border: var(--color-neutral-border);
  }
</style>
