---
interface Props {
  guideHref: string;
  statusHref: string;
  showInternalLinks?: boolean;
}

const { guideHref, statusHref, showInternalLinks = false } = Astro.props;
const calculusHref = "https://www.math.ntu.edu.tw/~calc/Default.html";
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p><strong>正式課務以各班 NTU COOL 為準。</strong></p>
    <nav aria-label="頁尾導覽">
      <a href={guideHref}>使用指南</a>
      <a href={calculusHref} target="_blank" rel="noreferrer">
        微積分統一教學網<span class="visually-hidden">（另開新分頁）</span>
      </a>
      {showInternalLinks && <a href={statusHref}>建造與系統狀態</a>}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    border-top: var(--border-thin) solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .site-footer__inner {
    padding-block: var(--space-6);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }
</style>
