# Astro build variables read by apps/portal/astro.config.mjs.
# The fixture portal needs neither variable for local development.
ASTRO_BASE_PATH=
ASTRO_SITE_URL=

# Public artifact mode is normally set by `npm run build:public`.
PUBLIC_PORTAL_BUILD=false

# Optional future same-origin path only, for example /api/join. Absolute URLs fail closed.
PUBLIC_JOIN_APPLICATION_ENDPOINT=
