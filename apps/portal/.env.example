# Astro build variables read by apps/portal/astro.config.mjs.
# The fixture portal needs neither variable for local development.
ASTRO_BASE_PATH=
ASTRO_SITE_URL=

# Public artifact mode is normally set by `npm run build:public`.
PUBLIC_PORTAL_BUILD=false

# Optional official course invite. Only https://discord.gg/<code> or
# https://discord.com/invite/<code> is accepted; invalid values fail closed.
PUBLIC_DISCORD_INVITE_URL=

# Optional same-origin paths only. Absolute URLs fail closed.
PUBLIC_JOIN_APPLICATION_ENDPOINT=
PUBLIC_CASE_STATUS_ENDPOINT=
PUBLIC_PORTAL_SESSION_ENDPOINT=
