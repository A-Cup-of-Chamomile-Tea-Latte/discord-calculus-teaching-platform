[Unit]
Description=Calculus SQLite to Google Apps Script bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=calculus-bot
Group=calculus-bot
WorkingDirectory=/opt/calculus-discord/current/runtime/discord-course-bots
EnvironmentFile=/etc/calculus-discord/data-bridge.env
ExecStart=/opt/calculus-discord/current/runtime/discord-course-bots/.venv/bin/discord-production-bridge daemon
Restart=on-failure
RestartSec=15s
TimeoutStopSec=75s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/calculus-discord

[Install]
WantedBy=multi-user.target
