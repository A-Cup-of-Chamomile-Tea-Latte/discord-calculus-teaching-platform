{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/activation-code.schema.json",
  "title": "ActivationCode",
  "description": "Stores only a verifier hash, never the redeemable plaintext nonce.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activationCodeId",
    "verifierHash",
    "status",
    "createdByUserId",
    "createdAt",
    "expiresAt",
    "redeemedAt",
    "revokedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "activationCodeId": { "$ref": "common.schema.json#/$defs/recordId" },
    "verifierHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": ["UNUSED", "USED", "EXPIRED", "REVOKED"]
    },
    "createdByUserId": { "$ref": "common.schema.json#/$defs/recordId" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "valueHash"],
      "properties": {
        "kind": { "type": "string", "enum": ["NONE", "EMAIL", "DISCORD_USER"] },
        "valueHash": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "NONE" } },
            "required": ["kind"]
          },
          "then": { "properties": { "valueHash": { "type": "null" } } },
          "else": {
            "properties": {
              "valueHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "permissionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "courseId", "classCode", "permissions"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["STUDENT", "TA", "INSTRUCTOR", "OBSERVER"]
        },
        "courseId": { "$ref": "common.schema.json#/$defs/recordId" },
        "classCode": { "type": ["string", "null"], "pattern": "^[0-9]{2}$" },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "JOIN_COURSE",
              "ACCESS_DISCORD",
              "ASK_QUESTIONS",
              "VIEW_ARCHIVE"
            ]
          }
        }
      }
    },
    "redeemedByUserId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/recordId" },
        { "type": "null" }
      ]
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "redeemedAt": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "revokedAt": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "redemptionRequestHash": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    }
  }
}
