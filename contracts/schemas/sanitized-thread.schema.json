{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/sanitized-thread.schema.json",
  "title": "SanitizedThread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceExportId",
    "sourceThreadSha256",
    "caseNumber",
    "generatedAt",
    "messages"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "sourceExportId": { "$ref": "common.schema.json#/$defs/recordId" },
    "sourceThreadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseNumber": { "$ref": "common.schema.json#/$defs/caseNumber" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageRef",
          "parentRef",
          "createdAt",
          "editedAt",
          "authorPseudonym",
          "authorRole",
          "contentStatus",
          "body",
          "source",
          "attachments"
        ],
        "properties": {
          "messageRef": { "type": "string", "pattern": "^m[0-9]{3,6}$" },
          "parentRef": {
            "oneOf": [
              { "type": "string", "pattern": "^m[0-9]{3,6}$" },
              { "type": "null" }
            ]
          },
          "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "editedAt": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/timestamp" },
              { "type": "null" }
            ]
          },
          "authorPseudonym": {
            "type": "string",
            "pattern": "^(?:student|ta|instructor|bot)-[0-9]{2,4}$"
          },
          "authorRole": {
            "type": "string",
            "enum": ["STUDENT", "TA", "INSTRUCTOR", "BOT"]
          },
          "contentStatus": {
            "type": "string",
            "enum": ["INCLUDED", "PLACEHOLDER"]
          },
          "body": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "source": { "$ref": "common.schema.json#/$defs/source" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attachmentLabel", "mediaType", "sizeBytes"],
              "properties": {
                "attachmentLabel": {
                  "type": "string",
                  "pattern": "^attachment-[0-9]{2,4}(?:\\.[a-z0-9]{1,10})?$"
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 100
                },
                "sizeBytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
