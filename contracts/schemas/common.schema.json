{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/common.schema.json",
  "title": "Calculus Teaching Platform Common Definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "discordId": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "caseNumber": {
      "type": "string",
      "description": "Opaque label: class or Guest identity, random token, Taipei month/day and time, plus optional Private suffix.",
      "pattern": "^(?:C[0-9]{2}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}-(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])-(?:[01][0-9]|2[0-3])[0-5][0-9](?:-P)?|Guest-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}-(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])-(?:[01][0-9]|2[0-3])[0-5][0-9])$"
    },
    "caseType": {
      "type": "string",
      "enum": ["GENERAL", "PRIVATE_SUPPORT"]
    },
    "caseStatus": {
      "type": "string",
      "enum": ["OPEN", "TRACKED", "IDLE", "CLOSED", "AUTO_CLOSED"]
    },
    "visibility": {
      "type": "string",
      "enum": ["CLASS", "COURSE", "TEACHING_STAFF"]
    },
    "authorDisplayMode": {
      "type": "string",
      "enum": ["REAL_NAME", "COURSE_ALIAS", "ANONYMOUS"]
    },
    "analysisPermission": {
      "type": "string",
      "enum": ["INCLUDED", "EXCLUDED"]
    },
    "analysisDecision": {
      "type": "string",
      "enum": ["INHERIT", "INCLUDED", "EXCLUDED"]
    },
    "source": {
      "type": "string",
      "enum": ["PORTAL", "DISCORD", "BOT", "IMPORT"]
    }
  }
}
