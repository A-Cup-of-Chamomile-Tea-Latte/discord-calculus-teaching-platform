{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/sanitized-package.schema.json",
  "title": "SanitizedPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "sourceExportId",
    "contentSha256",
    "caseCount",
    "createdAt",
    "reviewState",
    "containsPrivateSupport"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "$ref": "common.schema.json#/$defs/recordId" },
    "sourceExportId": { "$ref": "common.schema.json#/$defs/recordId" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseCount": { "type": "integer", "minimum": 0 },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "reviewState": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
    "containsPrivateSupport": { "const": false }
  }
}
