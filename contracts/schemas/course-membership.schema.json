{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/course-membership.schema.json",
  "title": "CourseMembership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "membershipId",
    "userId",
    "courseId",
    "classCode",
    "joiningOrder",
    "courseAlias",
    "verificationMethod",
    "status",
    "joinedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "membershipId": { "$ref": "common.schema.json#/$defs/recordId" },
    "userId": { "$ref": "common.schema.json#/$defs/recordId" },
    "courseId": { "$ref": "common.schema.json#/$defs/recordId" },
    "classCode": { "type": "string", "pattern": "^[0-9]{2}$" },
    "joiningOrder": { "type": "integer", "minimum": 1, "maximum": 999 },
    "courseAlias": { "type": "string", "pattern": "^[0-9]{5}$" },
    "verificationMethod": {
      "type": "string",
      "enum": ["EMAIL", "ACTIVATION_CODE", "MANUAL"]
    },
    "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "INACTIVE"] },
    "joinedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
