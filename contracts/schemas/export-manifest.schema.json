{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/v1/export-manifest.schema.json",
  "title": "ExportManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "caseId",
    "caseType",
    "initiatedByUserId",
    "mode",
    "analysisPermission",
    "messageCount",
    "cursor",
    "files",
    "createdAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "exportId": { "$ref": "common.schema.json#/$defs/recordId" },
    "caseId": { "$ref": "common.schema.json#/$defs/recordId" },
    "caseType": { "$ref": "common.schema.json#/$defs/caseType" },
    "initiatedByUserId": { "$ref": "common.schema.json#/$defs/recordId" },
    "mode": { "type": "string", "enum": ["DUMP", "FOLLOW"] },
    "analysisPermission": { "$ref": "common.schema.json#/$defs/analysisPermission" },
    "messageCount": { "type": "integer", "minimum": 0 },
    "cursor": { "type": ["string", "null"], "maxLength": 256 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": { "pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))" }
          },
          "mediaType": { "type": "string", "enum": ["application/json", "text/markdown"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "completedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "caseType": { "const": "PRIVATE_SUPPORT" } },
        "required": ["caseType"]
      },
      "then": { "properties": { "analysisPermission": { "const": "EXCLUDED" } } }
    }
  ]
}
