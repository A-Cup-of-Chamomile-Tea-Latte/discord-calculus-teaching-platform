{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/config/server.schema.json",
  "title": "Proposed Discord server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "source",
    "server",
    "roles",
    "userTypes",
    "modules",
    "classModuleMapping",
    "nicknameRules",
    "categories",
    "channels",
    "botPermissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PROPOSED_CONFIRMED_SOURCE"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "document",
        "priority",
        "note"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fixtureOnly",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^Fixture "
        },
        "fixtureOnly": {
          "const": true
        },
        "language": {
          "const": "zh-Hant"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "userTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "const": [
        "M1",
        "M2",
        "M3",
        "M4"
      ]
    },
    "classModuleMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING_AUGUST_ROSTER",
            "PENDING_CLASS_ROSTER",
            "APPROVED"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classCode",
              "moduleCode"
            ],
            "properties": {
              "classCode": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              },
              "moduleCode": {
                "enum": [
                  "M1",
                  "M2",
                  "M3",
                  "M4"
                ]
              }
            }
          }
        }
      }
    },
    "nicknameRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "studentPattern",
        "guestPattern",
        "retainHistory"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DISCORD_IDENTITY",
              "STUDENT_NNMMM",
              "GUEST_NNMMM"
            ]
          }
        },
        "studentPattern": {
          "type": "string"
        },
        "guestPattern": {
          "type": "string"
        },
        "retainHistory": {
          "type": "boolean"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "botPermissions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/botPermission"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "permission": {
      "enum": [
        "VIEW",
        "POST",
        "REPLY",
        "CREATE_THREAD",
        "MANAGE",
        "EXPORT",
        "CONNECT",
        "SPEAK"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "kind",
        "hierarchy",
        "publiclyDisplayed",
        "databaseOnly"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "STAFF",
            "LEARNER",
            "BOT",
            "ATTRIBUTE"
          ]
        },
        "hierarchy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "publiclyDisplayed": {
          "type": "boolean"
        },
        "databaseOnly": {
          "type": "boolean"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "enabled"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "permissionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "deny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "type",
        "parent",
        "topic",
        "slowmodeSeconds",
        "autoArchiveMinutes",
        "enabled",
        "managedCase",
        "forumTags",
        "permissions"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "TEXT",
            "FORUM",
            "VOICE"
          ]
        },
        "parent": {
          "$ref": "#/$defs/key"
        },
        "topic": {
          "type": "string"
        },
        "slowmodeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21600
        },
        "autoArchiveMinutes": {
          "enum": [
            60,
            1440,
            4320,
            10080
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "managedCase": {
          "type": "boolean"
        },
        "forumTags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/permissionDecision"
          }
        }
      }
    },
    "botPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "permissions",
        "scopedAreas"
      ],
      "properties": {
        "key": {
          "enum": [
            "course_assistant",
            "dump_bot"
          ]
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          }
        },
        "scopedAreas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      }
    }
  }
}
