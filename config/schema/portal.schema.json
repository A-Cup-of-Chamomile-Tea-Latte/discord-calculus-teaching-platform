{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calculus.local/config/portal.schema.json",
  "title": "Local portal proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "fixtureOnly",
    "language",
    "defaultTheme",
    "themes",
    "pages",
    "submissionFields",
    "lookupStates",
    "fixtureCaseNumbers",
    "externalConnections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED"
      ]
    },
    "fixtureOnly": {
      "const": true
    },
    "language": {
      "const": "zh-Hant"
    },
    "defaultTheme": {
      "enum": [
        "COURSE_FORMAL",
        "STUDENT_FRIENDLY"
      ]
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "description"
        ],
        "properties": {
          "key": {
            "enum": [
              "COURSE_FORMAL",
              "STUDENT_FRIENDLY"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "label",
          "audience",
          "enabled"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": [
              "ALL",
              "LEARNER",
              "STAFF_FIXTURE",
              "REVIEWER"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "submissionFields": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "lookupStates": {
      "type": "array",
      "contains": {
        "const": "OFFLINE"
      },
      "minContains": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FOUND",
          "NOT_FOUND",
          "INVALID",
          "OFFLINE",
          "STALE"
        ]
      }
    },
    "fixtureCaseNumbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^C[0-9]{2}-[A-HJ-NP-Z2-9]{6}-[0-9]{4}-[0-9]{4}(?:-P)?$"
      }
    },
    "externalConnections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discord",
        "email",
        "google",
        "oauth",
        "aiApi"
      ],
      "properties": {
        "discord": {
          "const": false
        },
        "email": {
          "const": false
        },
        "google": {
          "const": false
        },
        "oauth": {
          "const": false
        },
        "aiApi": {
          "const": false
        }
      }
    }
  }
}
